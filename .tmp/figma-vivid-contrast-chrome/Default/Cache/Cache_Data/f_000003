/*
 * StayTrack admin prototype compatibility layer
 * Loaded after styles.css. These rules intentionally target admin screens only;
 * the shared application shell, authentication, tenant portal, and profile keep
 * their own layout rules.
 */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) {
    width: 100%;
    max-width: calc(var(--content-max) + (var(--space-8) * 2));
    margin-right: auto;
    margin-left: auto;
}

/* Page headings and actions */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .page-heading {
    margin-bottom: var(--space-8);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .page-heading.heading-with-actions {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .heading-with-actions > div:first-child {
    min-width: 0;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .page-heading h1 {
    margin-top: var(--space-1);
    color: var(--text-strong);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.15;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .page-heading p {
    max-width: 42rem;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.5rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .back-link {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    transition: color var(--duration-fast);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .back-link:hover {
    color: var(--text-strong);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .back-link .icon,
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .text-link .icon {
    width: 1rem;
    height: 1rem;
}

/* Actual button modifiers used by index.html */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-primary {
    background: var(--primary);
    color: var(--white);
    box-shadow: var(--shadow-xs);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-primary:hover {
    background: var(--primary-hover);
    box-shadow: var(--shadow-sm);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-secondary {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--slate-700);
    box-shadow: var(--shadow-xs);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-secondary:hover {
    border-color: var(--slate-400);
    background: var(--slate-50);
    color: var(--text-strong);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-ghost {
    color: var(--text-muted);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-ghost:hover {
    background: var(--slate-100);
    color: var(--text-strong);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-small {
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .button.button-full {
    width: 100%;
}

/* Metrics */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-grid {
    margin-bottom: var(--space-6);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-card {
    isolation: isolate;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-card::after {
    position: absolute;
    z-index: -1;
    top: -3rem;
    right: -3rem;
    width: 7rem;
    height: 7rem;
    border-radius: var(--radius-pill);
    background: var(--slate-50);
    content: "";
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-card .metric-value {
    display: block;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-icon.slate,
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon.slate {
    background: var(--slate-100);
    color: var(--slate-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-icon.green,
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon.green {
    background: var(--emerald-50);
    color: var(--emerald-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-icon.blue,
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon.blue {
    background: var(--blue-50);
    color: var(--blue-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-icon.amber,
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon.amber {
    background: var(--amber-50);
    color: var(--amber-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon.red {
    background: var(--red-50);
    color: var(--red-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-foot {
    display: flex;
    min-height: 1.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: 0.75rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-foot button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    background: transparent;
    color: var(--slate-700);
    font-size: inherit;
    font-weight: 700;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-foot button:hover {
    color: var(--text-strong);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .metric-foot .icon {
    width: 0.875rem;
    height: 0.875rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .trend.positive,
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .success-text {
    color: var(--emerald-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .warning-text {
    color: var(--amber-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .danger-text {
    color: var(--red-700);
}

/* Dashboard panels, finance summary, occupancy chart, and recent leases */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(17rem, 0.85fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .dashboard-grid-lower {
    grid-template-columns: minmax(17rem, 0.85fr) minmax(0, 2fr);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .panel-header h2 {
    color: var(--text-strong);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    line-height: 1.5rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .panel-header p {
    margin-top: 0.125rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .text-link {
    gap: var(--space-1);
    padding: 0;
    border: 0;
    background: transparent;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .finance-panel {
    display: flex;
    flex-direction: column;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .finance-panel > .button {
    width: auto;
    margin: auto var(--space-6) var(--space-6);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-list {
    padding: var(--space-2) var(--space-6) var(--space-5);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-list > div {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--slate-100);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-list > div:last-child {
    border-bottom: 0;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-list > div > span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-list > div > strong {
    color: var(--text-strong);
    font-size: 1rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--slate-100);
    color: var(--slate-700);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .summary-icon .icon {
    width: 1.25rem;
    height: 1.25rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .occupancy-body {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-6);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .donut {
    position: relative;
    display: grid;
    width: 8.75rem;
    height: 8.75rem;
    place-items: center;
    border-radius: var(--radius-pill);
    background: conic-gradient(var(--slate-900) 0 79%, var(--emerald-600) 79% 91%, var(--amber-600) 91% 96%, var(--red-600) 96% 100%);
    box-shadow: inset 0 0 0 1px var(--border);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .donut::before {
    position: absolute;
    inset: 1rem;
    border-radius: inherit;
    background: var(--surface);
    content: "";
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .donut > span {
    position: relative;
    display: grid;
    text-align: center;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .donut strong {
    color: var(--text-strong);
    font-size: 1.5rem;
    letter-spacing: -0.04em;
    line-height: 1.75rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .donut small {
    margin-top: 0.125rem;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: 0.8125rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend li strong {
    color: var(--text-strong);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend-dot.occupied { background: var(--slate-900); }
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend-dot.available { background: var(--emerald-600); }
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend-dot.reserved { background: var(--amber-600); }
:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .legend-dot.maintenance { background: var(--red-600); }

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list > button {
    display: grid;
    width: 100%;
    min-height: 4.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--slate-100);
    background: var(--surface);
    color: var(--text);
    text-align: left;
    transition: background-color var(--duration-fast);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list > button:last-child {
    border-bottom: 0;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list > button:hover {
    background: var(--slate-50);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list > button > span:nth-child(2) {
    display: grid;
    min-width: 0;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list strong {
    color: var(--text-strong);
    font-size: 0.875rem;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list small {
    overflow: hidden;
    margin-top: 0.125rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .lease-list > button > .icon:last-child {
    width: 1rem;
    height: 1rem;
    color: var(--text-subtle);
    transform: rotate(-90deg);
}

/* Compact finance/property metrics */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .compact-metrics {
    gap: var(--space-4);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .mini-stat {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .mini-stat > span:last-child {
    display: grid;
    min-width: 0;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .mini-stat small {
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1rem;
    text-transform: uppercase;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .mini-stat strong {
    overflow: hidden;
    margin-top: 0.125rem;
    color: var(--text-strong);
    font-size: 1.125rem;
    letter-spacing: -0.025em;
    line-height: 1.5rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Toolbars, filters, data tables, record cells, and pagination */

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .toolbar {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .search-field {
    position: relative;
    display: flex;
    width: min(100%, 22rem);
    min-width: 14rem;
    align-items: center;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .search-field > .icon {
    position: absolute;
    z-index: 1;
    left: var(--space-3);
    width: 1rem;
    height: 1rem;
    color: var(--text-subtle);
    pointer-events: none;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .search-field input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.625rem var(--space-4) 0.625rem 2.375rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    outline: 0;
    background: var(--surface);
    color: var(--text-strong);
    font-size: 0.8125rem;
    box-shadow: var(--shadow-xs);
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .search-field input:focus {
    border-color: var(--slate-500);
    box-shadow: 0 0 0 3px var(--slate-100);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .search-field input::placeholder {
    color: var(--text-subtle);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .filter-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .chip {
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .chip:hover {
    border-color: var(--border-strong);
    background: var(--slate-50);
    color: var(--text-strong);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .chip.is-active {
    border-color: var(--slate-900);
    background: var(--slate-900);
    color: var(--white);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .select-compact {
    position: relative;
    display: flex;
    align-items: center;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .select-compact > .icon {
    position: absolute;
    z-index: 1;
    left: var(--space-3);
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
    pointer-events: none;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .select-compact select {
    min-height: 2.75rem;
    padding: 0.625rem 2.25rem 0.625rem 2.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    outline: 0;
    background-color: var(--surface);
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 650;
    box-shadow: var(--shadow-xs);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .table-wrap table {
    width: 100%;
    color: var(--text);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    text-align: left;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .table-wrap thead {
    background: var(--slate-50);
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .table-wrap th {
    height: 2.75rem;
    padding: 0.75rem var(--space-5);
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1rem;
    text-transform: uppercase;
    white-space: nowrap;
}

:where(#prototype-main > .screen:not([data-screen="tenant-dashboard"]):not([data-screen="profile"])) .table-wrap td {
