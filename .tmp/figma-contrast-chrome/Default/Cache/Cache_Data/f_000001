                                        <tr><td><span class="person-cell"><span class="avatar avatar-soft">LV</span><span><strong>Lea Villanueva</strong><small>Bill #ST-1042</small></span></span></td><td>C-105</td><td>Aug 30, 2026</td><td><span class="tag tag-green">Cash</span></td><td class="align-right"><strong>₱10,000</strong><small class="status-text warning-text">Partial</small></td></tr>
                                    </tbody>
                                </table>
