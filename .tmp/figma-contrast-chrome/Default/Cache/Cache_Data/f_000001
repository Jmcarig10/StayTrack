                            <label for="login-email">Email address</label>
                            <input id="login-email" name="email" type="email" value="maria@staytrack.ph" autocomplete="email" required>
                        </div>
                        <div class="field">
                            <div class="label-row">
                                <label for="login-password">Password</label>
                                <button class="text-button" type="button" data-action="forgot-password">Forgot password?</button>
                            </div>
                            <div class="password-field">
                                <input id="login-password" name="password" type="password" value="staytrack2026" autocomplete="current-password" required>
                                <button type="button" class="icon-button password-toggle" data-password-toggle="login-password" aria-label="Show password">
                                    <svg class="icon"><use href="#icon-eye"/></svg>
                                </button>
                            </div>
                        </div>
                        <label class="check-row" for="remember-me">
                            <input id="remember-me" type="checkbox" checked>
                            <span>Keep me signed in on this device</span>
                        </label>
                        <button class="button button-primary button-large button-full" type="submit" data-role="admin">
                            Sign in as administrator
                            <svg class="icon"><use href="#icon-arrow"/></svg>
                        </button>
                    </form>

